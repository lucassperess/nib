{
  "name": "nib-desktop",
  "version": "0.5.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Nib — a little desktop companion for saving media",
  "author": "Lucas Peres",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "dist:win": "pnpm build && pnpm prepare:tools && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "dev.nib.desktop",
    "productName": "Nib",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      { "from": "extension", "to": "extension" },
      { "from": ".runtime/yt-dlp.exe", "to": "yt-dlp.exe" },
      { "from": ".runtime/ffmpeg.exe", "to": "ffmpeg.exe" },
      {
        "from": ".runtime/node.exe",
        "to": "node.exe"
      },
      { "from": "LICENSE", "to": "legal/Nib-LICENSE.txt" },
      { "from": "ASSET_LICENSE.md", "to": "legal/ASSET_LICENSE.md" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "legal/THIRD_PARTY_NOTICES.md" },
      { "from": "legal/yt-dlp-LICENSE.txt", "to": "legal/yt-dlp-LICENSE.txt" },
      { "from": "legal/yt-dlp-THIRD_PARTY_LICENSES.txt", "to": "legal/yt-dlp-THIRD_PARTY_LICENSES.txt" },
      { "from": "legal/ffmpeg-GPL-3.0.txt", "to": "legal/ffmpeg-GPL-3.0.txt" },
      { "from": "legal/ffmpeg-build-README.txt", "to": "legal/ffmpeg-build-README.txt" },
      { "from": "legal/node-LICENSE.txt", "to": "legal/node-LICENSE.txt" },
      { "from": "legal/svelte-LICENSE.md", "to": "legal/svelte-LICENSE.md" },
      { "from": "legal/better-sqlite3-LICENSE.txt", "to": "legal/better-sqlite3-LICENSE.txt" }
    ],
    "win": {
      "icon": "assets/branding/nib.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
